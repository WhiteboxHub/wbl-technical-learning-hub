                "exec": [
                  "pm.test('status is 304', () => pm.response.to.have.status(304));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH with stale If-Match -> 412",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "If-Match",
                "value": "\"stale\""
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v2/employees/3",
              "host": [
