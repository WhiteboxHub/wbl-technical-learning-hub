      "name": "5 Advanced: ETag, If-Match, Idempotency-Key",
      "item": [
        {
          "name": "GET employee 3 (note the ETag)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/employees/3",
              "host": [
                "{{base_url}}"
              ],
              "path": [
