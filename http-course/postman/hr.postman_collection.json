            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo\",\n  \"email\": \"postman.demo@example.com\",\n  \"title\": \"Analyst\",\n  \"department_id\": 3,\n  \"manager_id\": 3,\n  \"hire_date\": \"2024-05-01\",\n  \"salary\": 80000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
