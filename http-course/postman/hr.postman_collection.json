                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json(); pm.collectionVariables.set('emp_id', j.id);",
                  "pm.test('Location header points at the new resource', () => pm.expect(pm.response.headers.get('Location')).to.eql('/v2/employees/' + j.id));"
