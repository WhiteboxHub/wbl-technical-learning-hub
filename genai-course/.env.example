# Copy this file to .env and fill in your key before running.
# NEVER commit .env to git.

# Required: get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# LLM and embedding models (defaults shown)
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# ChromaDB connection (matches docker-compose.yml service name)
CHROMA_HOST=vector-db
CHROMA_PORT=8000

# RAG defaults (instructors can override with break.sh)
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Set to 1 to disable abstention (break.sh hallucination-trap uses this)
ABSTENTION_DISABLED=0

# Temperature override (break.sh high-temperature sets to 1.8)
# Leave blank to use per-request value
TEMPERATURE_OVERRIDE=

LOG_LEVEL=INFO
